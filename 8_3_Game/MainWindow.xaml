        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Canvas Name="GameField">
        <Image x:Name="city" Tag="layer0" gif:ImageBehavior.AnimatedSource="/Sprites/cityone.gif" gif:ImageBehavior.RepeatBehavior="0x" gif:ImageBehavior.AnimationSpeedRatio="0.90"  Height="2200"  Canvas.Top="-1100" Width="2200"  Canvas.Left="-1100">

        </Image>

        <Image x:Name="Player"
           Width="64"
           Height="64"
           Canvas.Left="338"
           Canvas.Top="224"
           Stretch="Fill"
