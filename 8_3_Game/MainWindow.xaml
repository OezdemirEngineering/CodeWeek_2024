        <Rectangle Tag="wall" Height="302" Canvas.Left="241" Canvas.Top="-101" Width="354" HorizontalAlignment="Center" VerticalAlignment="Top" />
        <Rectangle Tag="wall" Height="383" Canvas.Left="657" Canvas.Top="-43" Width="1108" HorizontalAlignment="Center" VerticalAlignment="Top" />
        <Rectangle Tag="wall" Height="882" Canvas.Left="-316" Canvas.Top="-101" Width="354" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <Rectangle Tag="wall" Height="932" Canvas.Left="741" Canvas.Top="-708" Width="1108" HorizontalAlignment="Left" VerticalAlignment="Top" />
        <Rectangle Tag="wall" Height="932" Canvas.Left="-139" Canvas.Top="-1324" Width="1108" HorizontalAlignment="Left" VerticalAlignment="Top" />
        <Rectangle Tag="wall" Height="932" Canvas.Left="-316" Canvas.Top="542" Width="1108" HorizontalAlignment="Center" VerticalAlignment="Top" />
        <Rectangle Tag="wall" Height="383" Canvas.Left="729" Canvas.Top="345" Width="1108" HorizontalAlignment="Left" VerticalAlignment="Center" />

    </Canvas>
</Window>
